{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SqlData": {
    "ConnectionStringName": "IocEm",
    "DatabaseName": "IOCEM",
    "ConnectionMode": "ActiveDirectoryDefault"
  },
  "Reporting": {
    "ExternalProviderExecutivePacketAutomation": {
      "Enabled": false,
      "RunOnStartup": true,
      "IntervalMinutes": 60,
      "Provider": null,
      "RollingDays": 30,
      "WindowHours": 720,
      "BucketMinutes": 60,
      "OutputDirectory": "executive-packets",
      "MaxRetainedFiles": 180,
      "Transport": {
        "Mode": "None",
        "DistributionDirectory": null,
        "WebhookEndpoint": "<WEBHOOK_ENDPOINT_OR_NULL>",
        "WebhookAuthorizationHeader": "<WEBHOOK_AUTH_HEADER_OR_NULL>"
      },
      "Retry": {
        "MaxAttempts": 3,
        "InitialDelaySeconds": 30,
        "MaxDelaySeconds": 180
      }
    }
  },
  "ConnectionStrings": {
    "IocEm": "Server=tcp:<SQL_SERVER_FQDN>,1433;Initial Catalog=<DATABASE_NAME>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default;",
    "IocEmIntegratedTemplate": "Server=tcp:<SQL_SERVER_FQDN>,1433;Initial Catalog=<DATABASE_NAME>;Persist Security Info=False;User ID=<YOUR_USERNAME>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Integrated;"
  },
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/<TENANT_ID_OR_DOMAIN>/",
    "Audience": "api://<APP_CLIENT_ID_OR_API_URI>"
  },
  "AzureOpenAI": {
    "Enabled": true,
    "Endpoint": "https://<AZURE_OPENAI_RESOURCE>.openai.azure.com/",
    "Deployment": "<AZURE_OPENAI_DEPLOYMENT_NAME>",
    "Model": "<AZURE_OPENAI_MODEL_NAME>",
    "ApiVersion": "2025-04-01-preview",
    "ApiKey": "<AZURE_OPENAI_API_KEY_OR_EMPTY_FOR_MI>",
    "UseManagedIdentity": true
  },
  "AzureAISearch": {
    "Enabled": true,
    "Endpoint": "https://<AZURE_AI_SEARCH_SERVICE>.search.windows.net",
    "ApiKey": "<AZURE_AI_SEARCH_API_KEY_OR_EMPTY_FOR_MI>",
    "IndexName": "<AZURE_AI_SEARCH_INDEX_NAME>",
    "SemanticConfiguration": "<AZURE_AI_SEARCH_SEMANTIC_CONFIG>",
    "QueryType": "semantic",
    "DataSourceType": "AzureSql",
    "UseManagedIdentity": true
  },
  "AllowedHosts": "*"
}
