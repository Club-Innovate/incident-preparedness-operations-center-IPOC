    "smoke:reports": "node ./scripts/reports-interaction-smoke.mjs",
    "smoke:execution": "node ./scripts/execution-lane-interaction-smoke.mjs",
    "smoke:after-action-replay": "node ./scripts/after-action-replay-interaction-smoke.mjs",
    "smoke:all": "npm run smoke:authz && npm run smoke:ui && npm run smoke:assistant-personalization && npm run smoke:assistant-personalization-api && npm run smoke:reports && npm run smoke:execution && npm run smoke:after-action-replay"
  },
  "dependencies": {
