# Frontend environment template
# Copy this file to .env.development (or .env) and replace placeholder values.
# Runtime files with real values are ignored by Git.

# Base API URL used by frontend (optional in local AppHost flows)
VITE_API_BASE_URL=https://localhost:7435

# Azure AD / MSAL placeholders
VITE_AZURE_TENANT_ID=<TENANT_ID_GUID_OR_DOMAIN>
VITE_AZURE_CLIENT_ID=<CLIENT_ID_GUID>
VITE_AZURE_API_SCOPE=<API_SCOPE_URI>
VITE_AZURE_REDIRECT_URI=https://localhost:51015
